@prefix cf:      <https://gerfr.github.io/Cashflow/ontology/cashflow#> .
@prefix cfcat:   <https://gerfr.github.io/Cashflow/ontology/categories#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
#  Default category scheme
#
#  * Two levels: top-level categories carry cf:categoryKind, which narrower
#    categories inherit.
#  * skos:notation is the stable machine key (used in the database, in rules
#    and in connector category hints). Labels may change, notations may not.
#  * skos:altLabel (mostly German) holds synonyms; together with the labels and
#    definitions they seed zero-shot ML categorisation (see docs/DESIGN.md, "Machine learning").
#  * Uncategorised items simply have no cf:category; analytics show them as
#    a separate "Uncategorised" bubble.
# =============================================================================

cfcat:DefaultScheme
    a cf:CategoryScheme ;
    skos:prefLabel "Default categories"@en , "Standardkategorien"@de ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-19"^^xsd:date ;
    skos:hasTopConcept
        cfcat:Income , cfcat:Housing , cfcat:Food , cfcat:Transport , cfcat:Shopping ,
        cfcat:Health , cfcat:Leisure , cfcat:Subscriptions , cfcat:Insurance ,
        cfcat:Travel , cfcat:Education , cfcat:Finance , cfcat:Giving ,
        cfcat:Savings , cfcat:Transfers .

# --- Income ------------------------------------------------------------------

cfcat:Income a cf:Category ; skos:topConceptOf cfcat:DefaultScheme ; skos:inScheme cfcat:DefaultScheme ;
    skos:notation "INCOME" ; cf:categoryKind cf:IncomeKind ;
    skos:prefLabel "Income"@en , "Einnahmen"@de .

cfcat:Salary a cf:Category ; skos:inScheme cfcat:DefaultScheme ; skos:broader cfcat:Income ;
    skos:notation "INCOME.SALARY" ;
    skos:prefLabel "Salary & wages"@en , "Gehalt & Lohn"@de ;
    skos:altLabel "Lohn"@de , "Bezüge"@de , "Gehalt"@de .

cfcat:SideIncome a cf:Category ; skos:inScheme cfcat:DefaultScheme ; skos:broader cfcat:Income ;
    skos:notation "INCOME.SIDE" ;
    skos:prefLabel "Side income"@en , "Nebeneinkünfte"@de ;
    skos:altLabel "Honorar"@de , "Nebenjob"@de .

cfcat:Refunds a cf:Category ; skos:inScheme cfcat:DefaultScheme ; skos:broader cfcat:Income ;
    skos:notation "INCOME.REFUNDS" ;
    skos:prefLabel "Reimbursements"@en , "Erstattungen"@de ;
    skos:definition "Money paid back to you that is not a refund of a specific purchase (e.g. expense reimbursement, tax refund). Purchase refunds belong to the purchase's category."@en ;
    skos:altLabel "Rückerstattung"@de , "Auslagenerstattung"@de , "Steuererstattung"@de .

cfcat:InterestDividends a cf:Category ; skos:inScheme cfcat:DefaultScheme ; skos:broader cfcat:Income ;
    skos:notation "INCOME.INTEREST_DIVIDENDS" ;
    skos:prefLabel "Interest & dividends"@en , "Zinsen & Dividenden"@de ;
    skos:altLabel "Habenzinsen"@de , "Ausschüttung"@de .

cfcat:OtherIncome a cf:Category ; skos:inScheme cfcat:DefaultScheme ; skos:broader cfcat:Income ;
    skos:notation "INCOME.OTHER" ;
    skos:prefLabel "Other income"@en , "Sonstige Einnahmen"@de .

