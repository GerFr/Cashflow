# --- Privacy guard ------------------------------------------------------------
# Never commit real bank exports, receipts or databases. Put personal files in
# one of these locations (or name them *.private.*) and they stay local.
/data/
/private/
/imports/
*.private.*
/temp/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm

# --- Python ---------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.env
.env.*
!.env.example

# --- ML artifacts (downloaded on demand, never committed) -------------------------
*.onnx
*.gguf
*.safetensors

# --- OS / editors ------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
